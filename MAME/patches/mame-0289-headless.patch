+- (void)_freeMachine
+{
+	_gameDriver = nil;
+	_joystick = nil;
+	_mouse = nil;
+	_keyboard = nil;
+	_supportsSave = NO;
+	@synchronized (self) { [_activeCheats removeAllObjects]; }
+
+	_manager->set_machine(nullptr);
+
+	if (_machine)
+	{
+		_machine->headless_deinit();
+		delete _machine;
+		_machine = nil;
+	}
+
+	if (_config)
+	{
+		delete _config;
+		_config = nil;
+	}
+}
