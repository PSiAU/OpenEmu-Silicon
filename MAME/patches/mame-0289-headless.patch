+
+- (NSData *)serializeState
+{
+	if (!_supportsSave)
+	{
+		return nil;
+	}
+
+	auto sz = ram_state::get_size(_machine->save());
+	void *buf = malloc(sz);
+	auto res = _machine->save().write_buffer(buf, sz);
+	if (res != STATERR_NONE)
+	{
+		free(buf);
+		return nil;
+	}
+
+	return [[NSData alloc] initWithBytesNoCopy:buf length:sz freeWhenDone:YES];
+}
+
+- (BOOL)deserializeState:(NSData *)data
+{
+	if (!_supportsSave)
+	{
+		return NO;
+	}
+
+	auto res = _machine->save().read_buffer(const_cast<void *>(data.bytes), data.length);
+	return static_cast<BOOL>(res == STATERR_NONE);
+}
