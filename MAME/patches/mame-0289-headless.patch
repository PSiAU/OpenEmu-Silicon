+project ("osd_" .. _OPTIONS["osd"])
+	targetsubdir(_OPTIONS["target"] .."_" .._OPTIONS["subtarget"])
+	uuid (os.uuid("osd_" .. _OPTIONS["osd"]))
+	kind (LIBTYPE)
+
+	flags {
+		"ObjcARC",
+	}
+
+	dofile("headless_cfg.lua")
