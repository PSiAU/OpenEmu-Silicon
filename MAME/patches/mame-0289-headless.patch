+#import "driver+private.h"
+#import "DriverList+Private.h"
+#import <emu.h>
+#import "../../frontend/mame/infoxml.h"
+
+@implementation GameDriver {
+	game_driver const *_driver;
+	NSString *_name;
+	NSString *_shortName;
+	NSString *_fullName;
+	NSString *_parent;
+}
+
+- (instancetype)initWithGameDriver:(game_driver const *)driver
+{
+	if ((self = [super init]))
+	{
+		_driver = driver;
+	}
+	return self;
+}
+
+- (NSString *)name
+{
+	return _name ?: (_name = NSSTRING_NO_COPY(_driver->name));
+}
+
+- (NSString *)shortName
+{
+	return _shortName ?: (_shortName = NSSTRING_NO_COPY(_driver->type.shortname()));
+}
+
+- (NSString *)fullName
+{
+	return _fullName ?: (_fullName = NSSTRING_NO_COPY(_driver->type.fullname()));
+}
+
+- (NSString * __nullable)parent
+{
+	if (_driver->parent == nullptr) return nil;
+
+	return _parent ?: (_parent = NSSTRING_NO_COPY(_driver->parent));
+}
+
+- (NSString *)description
+{
+	return [NSString stringWithFormat:@"%@ (%@)", self.fullName, self.name];
+}
+
+- (GameDriverOptions)flags
+{
+	// Preserve the public wrapper flags after MAME moved status into device types.
+	NSUInteger flags = GameDriverMachineTypeArcade;
+	if (_driver->flags & MACHINE_NO_COCKTAIL) flags |= GameDriverMachineNoCocktail;
+	if (_driver->flags & MACHINE_IS_BIOS_ROOT) flags |= GameDriverMachineIsBiosRoot;
+	if (_driver->flags & MACHINE_REQUIRES_ARTWORK) flags |= GameDriverMachineRequiresArtwork;
+	if (_driver->flags & MACHINE_UNOFFICIAL) flags |= GameDriverMachineUnofficial;
+	if (_driver->flags & MACHINE_NO_SOUND_HW) flags |= GameDriverMachineNoSoundHw;
+	if (_driver->flags & MACHINE_MECHANICAL) flags |= GameDriverMachineMechanical;
+	if (_driver->flags & MACHINE_IS_INCOMPLETE) flags |= GameDriverMachineIsIncomplete;
+	if (_driver->type.emulation_flags() & device_t::flags::NOT_WORKING) flags |= GameDriverMachineNotWorking;
+	if (!(_driver->type.emulation_flags() & device_t::flags::SAVE_UNSUPPORTED)) flags |= GameDriverMachineSupportsSave;
+	if (_driver->type.unemulated_features() & device_t::feature::PROTECTION) flags |= GameDriverMachineUnemulatedProtection;
+	if (_driver->type.unemulated_features() & device_t::feature::PALETTE) flags |= GameDriverMachineWrongColors;
+	if (_driver->type.imperfect_features() & device_t::feature::PALETTE) flags |= GameDriverMachineImperfectColors;
+	if (_driver->type.imperfect_features() & device_t::feature::GRAPHICS) flags |= GameDriverMachineImperfectGraphics;
+	if (_driver->type.unemulated_features() & device_t::feature::SOUND) flags |= GameDriverMachineNoSound;
+	if (_driver->type.imperfect_features() & device_t::feature::SOUND) flags |= GameDriverMachineImperfectSound;
+	if (_driver->type.imperfect_features() & device_t::feature::CONTROLS) flags |= GameDriverMachineImperfectControls;
+	if (_driver->type.unemulated_features() & device_t::feature::MICROPHONE) flags |= GameDriverMachineNoDeviceMicrophone;
+	if (_driver->type.unemulated_features() & device_t::feature::PRINTER) flags |= GameDriverMachineNoDevicePrinter;
+	if (_driver->type.unemulated_features() & device_t::feature::LAN) flags |= GameDriverMachineNoDeviceLan;
+	if (_driver->type.imperfect_features() & device_t::feature::TIMING) flags |= GameDriverMachineImperfectTiming;
+	return static_cast<GameDriverOptions>(flags);
+}
+
+- (void)dealloc
+{
+	NSLog(@"%@: dealloc", NSStringFromClass(self.class));
+}
+
+@end
+
+#import "drivenum.h"
+
+static GameDriver * __strong * s_drivers_sorted;
+
+@implementation DriverList {
+	CFArrayRef _items;
+}
+
++ (DriverList *)shared
+{
+	static DriverList *obj;
+
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		s_drivers_sorted = static_cast<GameDriver * __strong *>(calloc(driver_list::total(), sizeof(GameDriver *)));
+		for (size_t i = 0; i < driver_list::total(); i++)
+		{
+			s_drivers_sorted[i] = [[GameDriver alloc] initWithGameDriver:&driver_list::driver(i)];
+		}
+
+		obj = [DriverList new];
+		obj->_items = CFArrayCreate(kCFAllocatorDefault, (const void * *)(void *)s_drivers_sorted, static_cast<CFIndex>(driver_list::total()), &kCFTypeArrayCallBacks);
+	});
+
+	return obj;
+}
+
+- (NSArray<GameDriver *> *)allDrivers
+{
+	return (__bridge NSArray *)_items;
+}
+
+- (GameDriver *)findWithName:(NSString *)name
+{
+	auto index = driver_list::find(name.UTF8String);
+	if (index == -1) {
+		return nil;
+	}
+
+	return s_drivers_sorted[index];
+}
+
+@end
